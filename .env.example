# Google Gemini
GEMINI_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Optional: Postgres in production (SQLite used if unset)
# DATABASE_URL=postgresql://user:pass@host:5432/placementprep

# Morning / evening job protection (Render cron or APScheduler)
CRON_SECRET=change-me
TIMEZONE=Asia/Kolkata
MORNING_HOUR=8
EVENING_HOUR=20

# Optional
PORT=8080
LOG_LEVEL=INFO
